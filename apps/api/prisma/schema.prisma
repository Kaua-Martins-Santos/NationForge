// Prisma schema do NationForge.
// Documentação: https://pris.ly/d/prisma-schema
//
// Os demais domínios do jogo (nações, população, economia...) serão criados nas
// fases seguintes, cada um na sua etapa.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // NestJS/ts-jest aqui rodam em CommonJS (o package.json não declara
  // "type": "module"). Sem isso, o gerador infere ESM e usa import.meta.url,
  // que quebra o Jest.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  // email é credencial de login (privado); displayName é o nome exibido a outros
  // jogadores em rankings, diplomacia e chat (público).
  email        String @unique
  displayName  String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
