// Prisma schema do NationForge.
// Documentação: https://pris.ly/d/prisma-schema
//
// Os demais domínios do jogo (população, economia, indústria...) serão criados
// nas fases seguintes, cada um na sua etapa.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // NestJS/ts-jest aqui rodam em CommonJS (o package.json não declara
  // "type": "module"). Sem isso, o gerador infere ESM e usa import.meta.url,
  // que quebra o Jest.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  // email é credencial de login (privado); displayName é o nome exibido a outros
  // jogadores em rankings, diplomacia e chat (público).
  email        String @unique
  displayName  String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nation Nation?

  @@map("users")
}

/// Formas de governo disponíveis (CLAUDE.md seção 20).
/// Enum em vez de texto livre: impede valores inválidos chegarem ao banco.
enum GovernmentType {
  DEMOCRACY
  MONARCHY
  DICTATORSHIP
  REPUBLIC
}

/// O país de um jogador.
///
/// Relação 1:1 com User (userId é único): cada usuário possui no máximo um país.
///
/// Guarda a identidade da nação e os atributos que ainda não têm domínio próprio.
/// Cada domínio do jogo ganha sua própria tabela 1:1 conforme é implementado
/// (PopulationState na Fase 10; economia, recursos e indústria depois), para que
/// cada fato tenha um único dono e os módulos fiquem de fato separados.
model Nation {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Definidos pelo jogador na criação.
  name       String         @unique
  flag       String
  capital    String
  government GovernmentType

  // Definidos pelo servidor. O cliente nunca envia estes valores: permitir isso
  // seria deixar o jogador escolher o próprio tesouro (CLAUDE.md seção 33).
  territory Int

  // Índices de 0 a 100.
  happiness Int
  stability Int

  /// Resto fracionário da felicidade, em milionésimos de ponto.
  ///
  /// Sem ele a mecânica de impostos não funcionaria: a variação de um tick é da
  /// ordem de 0,003 ponto, que arredondaria para zero todas as vezes — o imposto
  /// nunca chegaria a incomodar ninguém. Mesma técnica dos demais `carry`.
  happinessCarryMicro Int @default(0)

  technology     Int
  militaryPower  Int
  infrastructure Int
  emissions      Int

  /// Resto fracionário das emissões, em milionésimos de ponto. Mesmo motivo do
  /// `happinessCarryMicro`: a extração de um tick emite muito menos de um ponto.
  emissionsCarryMicro Int @default(0)

  /// Marco temporal da simulação: até quando os ticks já foram aplicados.
  ///
  /// Mora em Nation, e não em um domínio, porque o tempo é do país inteiro:
  /// população e economia avançam juntas, no mesmo laço, e um marco por domínio
  /// permitiria que saíssem de sincronia (ver `simulation/simulate.ts`).
  ///
  /// Avança em múltiplos exatos da duração do tick, nunca para "agora" — é o que
  /// impede o jogador de ganhar recursos recarregando a página (seção 26).
  simulatedUntil DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  populationState PopulationState?
  economyState    EconomyState?
  resourceState   ResourceState?

  @@map("nations")
}

/// Estado demográfico de um país — o domínio População (CLAUDE.md seção 12).
///
/// Dono único do número de habitantes: `total` mora aqui, e não em Nation, para
/// não existirem duas fontes da verdade para o mesmo fato.
model PopulationState {
  id       String @id @default(uuid())
  nationId String @unique
  nation   Nation @relation(fields: [nationId], references: [id], onDelete: Cascade)

  /// BigInt: o INTEGER do Postgres estoura em ~2,1 bilhões, alcançável por uma
  /// nação grande em um jogo de crescimento longo.
  total BigInt

  /// Resto fracionário do crescimento, em milionésimos de habitante (0 a 999999).
  ///
  /// Sem ele, cada cálculo arredondaria para habitante inteiro e jogaria a fração
  /// fora — então um jogador que abre o jogo de hora em hora acumularia MENOS
  /// população que um que espera um dia inteiro. Guardando o resto como inteiro
  /// exato, a aritmética dá o mesmo resultado por qualquer caminho.
  growthCarryMicro Int @default(0)

  /// Taxas anuais por mil habitantes, como na demografia real.
  birthRatePerThousand Int
  deathRatePerThousand Int

  /// Índices de 0 a 100. Nesta fase são fixos: serão movidos por gastos públicos
  /// (economia) e por hospitais e escolas (infraestrutura), em fases próprias.
  health    Int
  education Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("population_states")
}

/// Estado econômico de um país — o domínio Economia (CLAUDE.md seção 13).
///
/// O PIB **não** mora aqui: é derivado da força de trabalho e da produtividade a
/// cada leitura (ver `economy-calculations.ts`), pelo mesmo motivo que o emprego
/// é derivado na população — um campo persistido seria uma segunda fonte da
/// verdade para um número que já é consequência de outros.
///
/// Só persiste o que é acumulado (tesouro) ou escolhido pelo jogador (alíquota).
model EconomyState {
  id       String @id @default(uuid())
  nationId String @unique
  nation   Nation @relation(fields: [nationId], references: [id], onDelete: Cascade)

  /// Tesouro nacional, em centavos da moeda do jogo.
  ///
  /// BigInt de centavos, e não Decimal: os ticks fazem milhares de somas sobre
  /// este campo, e aritmética inteira é exata por construção — sem depender de
  /// arredondamento correto a cada passo. A seção 25 pede determinismo.
  ///
  /// Pode ficar negativo: um país gastando mais do que arrecada entra no
  /// vermelho. Dívida pública formal (juros, limite, calote) é uma fatia
  /// posterior da economia.
  treasuryCents BigInt

  /// Resto fracionário do saldo, em milionésimos de centavo (0 a 999999).
  ///
  /// Mesma técnica do `growthCarryMicro` da população, pelo mesmo motivo:
  /// arredondar a cada tick descartaria a fração, e a frequência com que o
  /// jogador abre o jogo mudaria quanto ele arrecada.
  treasuryCarryMicro Int @default(0)

  /// Alíquota de imposto, em pontos percentuais (0 a 100). É a decisão
  /// econômica do jogador: mais receita, menos felicidade (seção 13).
  taxRate Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("economy_states")
}

/// Recursos naturais do jogo (CLAUDE.md seção 14).
///
/// Enum, e não texto livre: cada valor tem preço, fator de emissão e raridade
/// definidos no catálogo do servidor. Adicionar um recurso novo é adicionar um
/// valor aqui e uma entrada lá — o resto das regras não muda.
enum ResourceType {
  IRON
  OIL
  COAL
  GOLD
  TIMBER
  WATER
  NATURAL_GAS
  URANIUM
}

/// Estado do domínio Recursos de um país.
///
/// Guarda o que é do país como um todo; os depósitos, que são vários, ficam em
/// `ResourceDeposit`.
model ResourceState {
  id       String @id @default(uuid())
  nationId String @unique
  nation   Nation @relation(fields: [nationId], references: [id], onDelete: Cascade)

  /// Intensidade de extração escolhida pelo jogador, 0 a 100.
  ///
  /// A decisão desta fase: extrair rápido rende dinheiro agora, mas consome
  /// reservas que não voltam e emite mais.
  extractionRate Int

  /// Semente da dotação natural do país.
  ///
  /// A geração é determinística dada a semente — mesma semente, mesmos
  /// depósitos, o que a torna testável e reproduzível. A semente é sorteada
  /// pelo servidor e persistida, em vez de derivada do nome do país: derivar do
  /// nome deixaria o jogador procurar nomes até achar uma dotação boa.
  seed Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits ResourceDeposit[]

  @@map("resource_states")
}

/// Um depósito de um recurso em um país.
///
/// Um registro por (país, recurso), e só para os recursos que o país de fato
/// possui — a ausência de linha significa "este país não tem esse recurso", que
/// é o que vai dar sentido ao comércio (seção 22).
model ResourceDeposit {
  id              String        @id @default(uuid())
  resourceStateId String
  resourceState   ResourceState @relation(fields: [resourceStateId], references: [id], onDelete: Cascade)

  type ResourceType

  /// Unidades ainda no solo. Finitas: o que sai não volta.
  reserves BigInt

  /// Total já extraído ao longo da história do país.
  ///
  /// Não é usado por nenhuma regra — existe para relatórios (Fase 21) e
  /// conquistas (Fase 31) poderem falar do que o país produziu.
  extractedTotal BigInt @default(0)

  /// Resto fracionário da extração, em milionésimos de unidade.
  extractionCarryMicro Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resourceStateId, type])
  @@map("resource_deposits")
}
