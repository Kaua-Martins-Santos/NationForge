# Copie este arquivo para ".env" e preencha com as credenciais reais do seu Postgres local.
# Nunca commitar o ".env" com valores reais (já está no .gitignore).
DATABASE_URL="postgresql://postgres:SENHA@localhost:7789/nationforge?schema=public"

# Segredo usado para assinar os JWTs de autenticação. Gere um valor aleatório
# (ex.: `openssl rand -hex 32`) — nunca reutilize o exemplo abaixo em produção.
JWT_SECRET="troque-por-um-valor-aleatorio-e-secreto"
JWT_EXPIRES_IN="1d"

# Origem do frontend autorizada a chamar a API (CORS). Precisa ser explícita,
# porque cookies de sessão não funcionam com origem coringa "*".
WEB_ORIGIN="http://localhost:3000"
