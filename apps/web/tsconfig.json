{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // O Next.js compila o próprio código: o TypeScript aqui só verifica tipos
    // (noEmit) e precisa de configurações de navegador/JSX que não fazem sentido
    // no tsconfig base, voltado a Node.
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
